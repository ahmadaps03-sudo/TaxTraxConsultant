{
  "name": "taxtrax-admin",
  "productName": "TaxTrax Admin",
  "version": "1.0.0",
  "description": "TaxTrax Consulting desktop admin panel",
  "main": "src/main.js",
  "private": true,
  "author": "TaxTrax Consulting",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.taxtrax.admin",
    "productName": "TaxTrax Admin",
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.business" },
    "linux": { "target": "AppImage", "category": "Office" }
  }
}
