# Copy to .env.local and fill in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random secret shared with the desktop admin app. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# WhatsApp number shown on the site (international format, digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional dedicated 32+ character random secret for HMAC visitor hashes.
# If empty, the server-only SITE_INGEST_SECRET is used. Never use a public value.
ANALYTICS_SALT=
# Set to 1 only behind an ingress that overwrites X-Forwarded-For and geo headers.
# Otherwise all requests share an "unknown" limiter bucket; untrusted IP headers are ignored.
TRUST_PROXY=

# Client Portal login/logout uses the configured Supabase project.
# For shared Dev, see docs/shared-dev.md. Never use Production for local tests.
# Obtain the publishable key from the chosen project's Connect dialog.
# Use an unprivileged sb_publishable_ key; legacy anon keys are not accepted at runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_ORIGIN=http://localhost:3000
ADMIN_PORTAL_SECRET=

# Server-only scoped pending-request capability; NOT a Supabase admin/service key.
# Obtain privately from Helio. Must match the Dev submit-access-request Edge secret.
ACCESS_REQUEST_SUBMISSION_SECRET=

# Server-only site-collection capabilities for Supabase Dev (distinct values).
# Obtain privately from the owner; never use a Supabase service-role key here.
SITE_INGEST_SECRET=
SITE_ADMIN_DATA_SECRET=

# Owner-configured, private review-only Dev capability; never reuse the public submission secret.
ADMIN_ACCESS_REQUEST_SECRET=
# Server-only Dev capability for sending a welcome email after verified first-password setup.
WELCOME_EMAIL_SECRET=

# Owner-only EmailJS hook setup; these credentials are used only by the Dev Edge Function.
# Obtain privately. Upload only these values to the Dev Edge Function secrets.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=template_ys2jlyd
# Invitation and post-setup welcome reuse the same account-creation template variables.
EMAILJS_INVITE_TEMPLATE_ID=template_zvyfzfx
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Generated/configured privately for the Supabase Send Email hook.
SEND_EMAIL_HOOK_SECRET=
RECOVERY_ALLOWED_ORIGINS=
ACTIVATION_ALLOWED_ORIGINS=
