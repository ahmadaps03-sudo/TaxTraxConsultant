# Copy to .env.local and fill in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random secret shared with the desktop admin app. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
# Optional: where submissions are stored (default ./data/db.json)
# DATA_FILE=./data/db.json

# WhatsApp number shown on the site (international format, digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: any random text; makes anonymous visitor hashes unguessable
ANALYTICS_SALT=
# Set to 1 if the site runs behind your own proxy/CDN so rate limits and analytics see real visitor IPs
TRUST_PROXY=

# Client Portal login/logout uses the shared Supabase DEVELOPMENT project, without Docker.
# See docs/shared-dev.md for setup. This is not production configuration/readiness.
# Obtain the Dev publishable key privately from Helio or the Dev project's Connect dialog.
# Use an unprivileged sb_publishable_ key; legacy anon keys are not accepted at runtime.
SUPABASE_URL=https://dbcakdqthnamgjfkkxzn.supabase.co
SUPABASE_PUBLISHABLE_KEY=
AUTH_ORIGIN=http://localhost:3000

# Owner-only EmailJS hook setup; not read by website authentication runtime.
# Obtain privately. Upload only these values to the Dev Edge Function secrets.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
# Separate invitation template: to_email and activation_url; recovery template unchanged.
EMAILJS_INVITE_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Generated/configured privately for the Supabase Send Email hook.
SEND_EMAIL_HOOK_SECRET=
RECOVERY_ALLOWED_ORIGINS=
ACTIVATION_ALLOWED_ORIGINS=
