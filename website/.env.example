# Copy to .env.local and fill in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random secret shared with the desktop admin app. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
# Optional: where submissions are stored (default ./data/db.json)
# DATA_FILE=./data/db.json

# WhatsApp number shown on the site (international format, digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: any random text; makes anonymous visitor hashes unguessable
ANALYTICS_SALT=
# Set to 1 if the site runs behind your own proxy/CDN so rate limits and analytics see real visitor IPs
TRUST_PROXY=
